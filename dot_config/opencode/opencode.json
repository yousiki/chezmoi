{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "--package",
        "chrome-devtools-mcp@latest",
        "chrome-devtools-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "--package",
        "@playwright/mcp@latest",
        "playwright-mcp"
      ],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "uvx",
        "--refresh",
        "--with",
        "duckduckgo-mcp-server",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "bunx",
        "--package",
        "typescript@latest",
        "--package",
        "typescript-language-server@latest",
        "typescript-language-server",
        "--stdio"
      ]
    },
    "pyright": {
      "command": [
        "bunx",
        "--package",
        "pyright@latest",
        "pyright-langserver",
        "--stdio"
      ]
    },
    "basedpyright": {
      "command": [
        "uvx",
        "--refresh",
        "--with",
        "basedpyright",
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [".py", ".pyi"]
    },
    "ty": {
      "command": ["uvx", "--refresh", "--with", "ty", "ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "biome": {
      "command": [
        "bunx",
        "--package",
        "@biomejs/biome@latest",
        "biome",
        "lsp-proxy"
      ]
    },
    "bash": {
      "command": [
        "bunx",
        "--package",
        "bash-language-server@latest",
        "bash-language-server",
        "start"
      ]
    },
    "yaml-ls": {
      "command": [
        "bunx",
        "--package",
        "yaml-language-server@latest",
        "yaml-language-server",
        "--stdio"
      ]
    },
    "tombi": {
      "command": ["bunx", "--package", "tombi@latest", "tombi", "lsp"],
      "extensions": [".toml"]
    },
    "vscode-html": {
      "command": [
        "bunx",
        "--package",
        "vscode-langservers-extracted@latest",
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [".html", ".htm"]
    },
    "vscode-css": {
      "command": [
        "bunx",
        "--package",
        "vscode-langservers-extracted@latest",
        "vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [".css", ".scss", ".less"]
    },
    "vscode-json": {
      "command": [
        "bunx",
        "--package",
        "vscode-langservers-extracted@latest",
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [".json", ".jsonc"]
    }
  },
  "formatter": {
    "ruff": {
      "command": [
        "uvx",
        "--refresh",
        "--with",
        "ruff",
        "ruff",
        "format",
        "$FILE"
      ]
    },
    "biome": {
      "command": [
        "bunx",
        "--package",
        "@biomejs/biome@latest",
        "biome",
        "format",
        "--write",
        "$FILE"
      ]
    },
    "prettier": {
      "command": [
        "bunx",
        "--package",
        "prettier@latest",
        "prettier",
        "--write",
        "$FILE"
      ]
    }
  }
}
